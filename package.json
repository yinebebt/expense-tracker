{
  "name": "expense-tracker",
  "version": "0.1.9",
  "versionCode": 4,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "android": "ng build && cap run android",
    "android:live": "adb reverse tcp:4200 tcp:4200 && cap run android --live-reload --host localhost --port 4200 --forwardPorts 4200:4200",
    "apk": "ng build && cap sync android && cd android && ./gradlew assembleDebug -q",
    "apk:release": "ng build && cap sync android && cd android && ./gradlew assembleRelease -q",
    "version": "node scripts/bump-build.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@ionic/angular": "^9.0.9",
    "ionicons": "^8.1.0",
    "jeep-sqlite": "^2.8.0",
    "rxjs": "~7.8.0",
    "sql.js": "1.12.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/cli": "^8.5.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "sql.js": "1.12.0"
  }
}
